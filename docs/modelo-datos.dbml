// Modelo físico del backend administrativo AgeCare. Fuente: app/models.py.
// No consulta registros, secretos, una base desplegada ni la app Flutter.
// Solo Ref declara ForeignKey reales. UUID sin FK conserva su independencia.
// default representa valores del servidor; los defaults Python se explican en notas.
Project AgeCare_Admin {
  database_type: 'PostgreSQL'
  Note: 'Estructura ORM actual. No incluye alembic_version ni tablas de otra API móvil.'
}

Table admin_users {
  id uuid [pk, not null, note: 'Valor inicial generado por Python al insertar; no es un DEFAULT SQL.']
  full_name varchar(120) [not null]
  email varchar(254) [not null]
  password_hash varchar(255) [null]
  role varchar(20) [not null]
  is_active boolean [not null, note: 'Valor inicial asignado por Python: True']
  mfa_enabled boolean [not null, note: 'Valor inicial asignado por Python: False']
  mfa_secret varchar(512) [null]
  mfa_required boolean [not null, default: false]
  mfa_last_step integer [null]
  auth_version integer [not null, default: 0]
  recovery_hashes jsonb [null]
  invitation_cancelled_at timestamptz [null]
  invitation_delivery_status varchar(20) [null]
  failed_attempts integer [not null, note: 'Valor inicial asignado por Python: 0']
  failed_attempt_times jsonb [null]
  locked_until timestamptz [null]
  invitation_expires_at timestamptz [null]
  last_login_at timestamptz [null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    email [unique, name: 'ix_admin_users_email']
  }
}

