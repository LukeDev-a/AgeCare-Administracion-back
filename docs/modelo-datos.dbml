  target_url varchar(500) [null]
  is_active boolean [not null, note: 'Valor inicial asignado por Python: False']
  featured boolean [not null, note: 'Valor inicial asignado por Python: False']
  min_tier varchar(50) [not null, note: 'Valor inicial asignado por Python: gratuito']
  created_by uuid [null, note: 'Identificador sin clave foránea declarada en este modelo.']
  created_by_name varchar(120) [null]
  deleted_at timestamptz [null]
  updated_by uuid [null, note: 'Identificador sin clave foránea declarada en este modelo.']
  updated_by_name varchar(120) [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Actualización automática desde SQLAlchemy.']

  indexes {
    category [name: 'ix_games_apps_category']
    is_active [name: 'ix_games_apps_is_active']
    item_type [name: 'ix_games_apps_item_type']
    slug [unique, name: 'ix_games_apps_slug']
  }
}

Table analytics_accounts {
  id uuid [pk, not null, note: 'Valor inicial generado por Python al insertar; no es un DEFAULT SQL.']
  external_id varchar(120) [not null]
  profile varchar(12) [not null]
  data_origin varchar(12) [not null]
  created_at timestamptz [not null]

  indexes {
    created_at [name: 'ix_analytics_accounts_created_at']
    (data_origin, external_id) [unique]
  }
}

Table analytics_activity {
  id uuid [pk, not null, note: 'Valor inicial generado por Python al insertar; no es un DEFAULT SQL.']
  account_id uuid [not null]
  external_id varchar(120) [not null]
  action varchar(60) [not null]
  data_origin varchar(12) [not null]
  occurred_at timestamptz [not null]

  indexes {
    account_id [name: 'ix_analytics_activity_account_id']
    (data_origin, external_id) [unique]
  }
}

Table analytics_payments {
  id uuid [pk, not null, note: 'Valor inicial generado por Python al insertar; no es un DEFAULT SQL.']
  account_id uuid [not null]
  external_id varchar(120) [not null]
  data_origin varchar(12) [not null]
  amount_minor integer [not null]
  successful boolean [not null]
  subscription_active boolean [not null]
  occurred_at timestamptz [not null]

  indexes {
    account_id [name: 'ix_analytics_payments_account_id']
    (data_origin, external_id) [unique]
  }
}

Table analytics_sources {
  name varchar(30) [pk, not null]
  data_origin varchar(12) [pk, not null]
  available_through timestamptz [not null]
  updated_at timestamptz [not null, default: `now()`]
  revision integer [not null, note: 'Valor inicial asignado por Python: 1']
}

Table analytics_cohort_snapshots {
  month date [pk, not null]
  data_origin varchar(12) [pk, not null]
  payload jsonb [not null]
  source_signature varchar(64) [not null]
  computed_at timestamptz [not null, default: `now()`]
}

// Relaciones físicas (muchos a uno).
Ref: admin_sessions.admin_id > admin_users.id
Ref: admin_invitations.admin_id > admin_users.id [delete: cascade]
Ref: invitation_emails.invitation_id > admin_invitations.id [delete: cascade]
Ref: mfa_enrollments.admin_id > admin_users.id [delete: cascade]
Ref: demo_app_memberships.patient_id > demo_app_patients.id [delete: restrict]
Ref: demo_app_memberships.user_id > demo_app_accounts.id [delete: restrict]
Ref: feature_usage_window.feature_key > features.feature_key
Ref: ops_incident_emails.incident_id > ops_incidents.id [delete: cascade]
Ref: support_tickets.assigned_to > admin_users.id
Ref: support_ticket_replies.ticket_id > support_tickets.id
Ref: analytics_activity.account_id > analytics_accounts.id
Ref: analytics_payments.account_id > analytics_accounts.id
