# Referencia sin secretos. Completar solo variables necesarias en .env existente.
# Conservar ADMIN_ENCRYPTION_KEY, JWT, base de datos y correo ya configurados.
ADMIN_ALLOWS_ORIGINS=http://localhost:5173
ADMIN_FRONTEND_URL=http://localhost:5173

# Opcional: origen público (y prefijo del proxy si existe) para URLs de juegos.
# Vacío usa la URL base de la solicitud. No incluir /static/juegos aquí.
ADMIN_GAME_PUBLIC_BASE_URL=

# Contenido: conservar la clave real en .env, nunca en frontend.
ADMIN_GEMINI_API_KEY=
ADMIN_GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
ADMIN_GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
ADMIN_GEMINI_TTS_VOICE=Kore
# Activar solo tras comprobar que el proyecto usa cuota gratuita en AI Studio.
ADMIN_GEMINI_FREE_TIER_CONFIRMED=false
ADMIN_CONTENT_WORKER_ENABLED=false
ADMIN_CONTENT_AUDIO_DIR=content_audio
ADMIN_NEWS_COLLECTION_HOUR=8
ADMIN_NEWS_COLLECTION_LIMIT=20
ADMIN_NEWS_ADAPTATION_BATCH=5
ADMIN_GEMINI_TEXT_DAILY_LIMIT=500
ADMIN_GEMINI_TEXT_RPM=15
ADMIN_GEMINI_TEXT_INPUT_TPM=250000
ADMIN_GEMINI_TTS_DAILY_LIMIT=10
ADMIN_GEMINI_TTS_RPM=3
ADMIN_CONTENT_NEW_AUDIO_DAILY_LIMIT=5
