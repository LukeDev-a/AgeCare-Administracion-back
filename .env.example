# Referencia local sin secretos. No sobrescribir un .env ya configurado.
ADMIN_ENVIRONMENT=dev
ADMIN_ALLOWS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_FRONTEND_URL=http://localhost:5173
# Generar solo para una base independiente nueva; conservar para datos cifrados.
ADMIN_ENCRYPTION_KEY=
# Alta de cuatro cuentas conocidas, solo en desarrollo y con admin_users vacía.
ADMIN_BOOTSTRAP_DEV_ACCOUNTS=false
ADMIN_MFA_REQUIRED_ROLES=admin
ADMIN_CONTENT_WORKER_ENABLED=false
ADMIN_GEMINI_FREE_TIER_CONFIRMED=false
